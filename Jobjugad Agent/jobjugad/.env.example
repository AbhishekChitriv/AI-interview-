# ── LLM provider switch ───────────────────────────────────────────────────
# Which provider the unified factory uses by default: openai | gemini | groq | anthropic
LLM_PROVIDER=groq

# Provide at least the key for LLM_PROVIDER. Others are optional; the
# per-request `provider` field (Module 2) can select any that has a key.
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Optional model overrides (sensible defaults used if unset)
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-3.6-flash
# GROQ_MODEL=groq/compound
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# LLM_TIMEOUT=45

# Module 3 (aptitude round) has its own Groq model knob; it must be a plain
# chat model that reliably returns large JSON. Falls back to a curated 40-Q bank.
# APTITUDE_GROQ_MODEL=openai/gpt-oss-20b

# Module 3.5 (coding round) — same idea; a plain chat model that returns large
# JSON reliably. Falls back to a curated per-language question pool.
# CODING_GROQ_MODEL=openai/gpt-oss-20b

# ── optional infrastructure (leave blank to use in-memory + file storage) ─
# REDIS_URL=redis://localhost:6379/0
# MONGO_URI=mongodb://localhost:27017
# MONGO_DB=jobjugad

# ── server ────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
RELOAD=false
CORS_ORIGINS=*
# SESSION_TTL=43200
