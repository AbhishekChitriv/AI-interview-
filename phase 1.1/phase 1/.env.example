# Aura Voice AI Assistant Environment Configuration
# Copy this file to .env and fill in your API keys.

# Groq API Credentials
GROQ_API_KEY=
GROQ_MODEL=groq/compound-mini

# Google Gemini API Credentials (Optional)
GEMINI_API_KEY=

# OpenAI API Credentials (Optional)
OPENAI_API_KEY=

# Custom OpenAI-Compatible Endpoint Credentials (Optional, e.g., DeepSeek, OpenRouter)
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=

# Anthropic Claude API Credentials
ANTHROPIC_API_KEY=
